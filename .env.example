APP_NAME="Smart Community Saving"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vsla.test"
MAIL_FROM_NAME="${APP_NAME}"

VSLA_DEFAULT_CURRENCY=UGX
VSLA_DEFAULT_LATE_FEE_PCT=5
VSLA_DEFAULT_GRACE_DAYS=2
